{
  "expo": {
    "name": "LotusMart",
    "slug": "LotusmartApp",
    "version": "1.0.0",
    "scheme": "lotusmart",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.lotusmart.app",
      "config": {
        "googleMapsApiKey": "AIzaSyCLGtTkBHAljKzHgZ7OFK5HG1rUXsM3MZs"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LotusMart uses your location to auto-fill your delivery address so you can check out faster."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFDF7"
      },
      "package": "in.lotusmart.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCLGtTkBHAljKzHgZ7OFK5HG1rUXsM3MZs"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LotusMart uses your location to auto-fill your delivery address so you can check out faster."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "5dceaefe-5faf-4b61-bb36-d1cc3c4aee9e"
      }
    },
    "owner": "kkkkkwwwwwa"
  }
}
