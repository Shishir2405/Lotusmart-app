# Razorpay
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Google Maps (Places + Geocoding). Create a key in Google Cloud Console
# and restrict it to Android/iOS bundles. Also used by react-native-maps on Android.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Sign-In (OAuth 2.0 client IDs from Google Cloud Console).
# Web client id is required for expo-auth-session to obtain an id_token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
