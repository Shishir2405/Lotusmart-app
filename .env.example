# ------------------------------------------------------------------
# LotusMart Expo app — environment variables
#
# All variables MUST be prefixed with EXPO_PUBLIC_ to be readable in
# the client bundle (Expo inlines them at build time).
# Restart `expo start` after editing this file — values are not hot-reloaded.
# ------------------------------------------------------------------


# === Razorpay (payments) ==========================================
# Used by: src/services/razorpay.ts, src/modules/cart/screens/CheckoutScreen.tsx
# Needed when: user taps "Pay" on checkout.
# If missing: payment screen will fail to open a Razorpay order.
# Note: react-native-razorpay is a native module — NOT supported in Expo Go.
#       You must use an EAS dev build (eas build --profile development) to
#       actually complete a payment. In Expo Go the checkout UI renders but
#       the pay button will throw when invoked.
# Get it from: Razorpay Dashboard → Settings → API Keys
EXPO_PUBLIC_RAZORPAY_KEY_ID=


# === Google Maps (Places, Geocoding, react-native-maps Android) ====
# Used by: src/services/location.ts (Places Autocomplete + Geocoding REST API),
#          src/components/shared/LocationPicker.tsx,
#          app.json → android.config.googleMaps.apiKey (for react-native-maps on Android)
# Needed when: user opens the address / location picker screen.
# If missing: map tiles don't render on Android, places search is disabled;
#             the app falls back to device GPS + raw lat/lng only.
# Create in: Google Cloud Console → APIs & Services → Credentials → Create API key
# APIs to enable on that GCP project:
#   - Maps SDK for Android
#   - Maps SDK for iOS
#   - Places API
#   - Geocoding API
# Recommended restrictions:
#   - Android apps → add package "com.lotusmart.app" + your SHA-1
#   - iOS apps → add bundle id "com.lotusmart.app"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=


# === Google Sign-In (OAuth 2.0) ===================================
# Used by: src/services/googleAuth.ts (expo-auth-session)
# Needed when: user taps "Continue with Google" on the login screen.
# If missing: Google Sign-In button errors / never resolves an id_token.
# Create in: Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# All three client IDs should live under the same GCP project / consent screen.

# --- Web client (REQUIRED — this one does the work) ---------------
# expo-auth-session always exchanges the code via the Web client to get
# an id_token, even on Android/iOS. This is the primary one — set this first.
# Application type in GCP: Web application
# Authorized redirect URIs: https://auth.expo.io/@your-expo-username/LotusmartApp
#   (for Expo Go) — replace with your Expo account + app slug
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- iOS client (only for standalone iOS build — NOT Expo Go) -----
# Application type in GCP: iOS
# Bundle ID: com.lotusmart.app
# Leave blank until you do `eas build -p ios`.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Android client (only for standalone Android build — NOT Expo Go) ---
# Application type in GCP: Android
# Package name: com.lotusmart.app
# SHA-1: get via `npx eas-cli credentials` (EAS build) OR
#        `keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android -keypass android`
#        (local expo run:android debug build)
# Leave blank until you do `eas build -p android`.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
